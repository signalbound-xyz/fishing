# Fluent Connect (@fluent.xyz/connect). Copy to .env.local and fill in the values from the Fluent Dashboard.
# Every origin the app is served from (e.g. http://localhost:5180) must be allow-listed for Direct login.
VITE_FLUENT_APP_ID=
VITE_FLUENT_PRIVY_CLIENT_ID=

# Gameplay telemetry is recorded in the browser only (see README, "Gameplay telemetry"). `off` stops the recording.
# VITE_TELEMETRY=off

# Where the page asks for the daily reward authorization. Default: /api/daily-reward on the page's own origin.
# VITE_DAILY_REWARD_API=

# ---------------------------------------------------------------------------------------------------------------
# The daily reward verifier (DAILY_REWARDS.md). These are read by the serverless function, never by the page: they
# are not VITE_ variables and must not become ones. Set them in the host's environment (Vercel: Project Settings,
# Environment Variables, marked Sensitive), not in a file that is committed.
#
# DAILY_REWARD_SIGNER_KEY=      private key of the verifier, a key made for this and holding nothing (required)
# DAILY_REWARD_CHAIN_ID=        20994 by default (Fluent Testnet)
# DAILY_REWARD_RPC_URL=         the network's public RPC by default
# DAILY_REWARD_CONTRACT=        DailyRewards address; by default the one in deployments/<chainId>.json
# DAILY_REWARD_CONFIRMATIONS=   blocks under the head that count, 5 by default
# DAILY_REWARD_TTL_SECONDS=     how long an authorization is good for, 600 by default
# DAILY_REWARD_ALLOW_ORIGIN=    another origin allowed to call from a browser; not needed on the game's own origin
#
# Local development only: where `pnpm exec vite` forwards /api to (the address `pnpm api:dev` prints)
# DAILY_REWARD_PROXY=http://127.0.0.1:8787

# ---------------------------------------------------------------------------------------------------------------
# The operator's keeper (KEEPER.md). Read by the serverless function or by `pnpm keeper`, never by the page. Set
# them in the host's environment, or for a terminal in a git-ignored file (.env.keeper.local).
#
# CRON_SECRET=                  bearer token of /api/keeper; without it the endpoint is switched off (required)
# KEEPER_KEY=                   private key of a gas wallet made for this and holding nothing else (to send)
# KEEPER_CHAIN_ID=              20994 by default (Fluent Testnet)
# KEEPER_RPC_URL=               the network's public RPC by default
# KEEPER_GAME=, KEEPER_HUNT=    by default the addresses in deployments/<chainId>.json
# KEEPER_START_BLOCK=           by default the deployment's first block
# KEEPER_RESCUE_BLOCKS=         reel in a cast once fewer blocks than this are left of its window
# KEEPER_BUDGET_MS=             how long one pass may keep sending, 7000 by default
