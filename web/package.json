{
  "name": "onchain-fishing-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "sync": "node scripts/sync-abi.mjs",
    "dev": "node scripts/sync-abi.mjs && vite --port 5180 --strictPort",
    "build": "node scripts/sync-abi.mjs && tsc --noEmit && vite build",
    "build:api": "node scripts/build-api.mjs",
    "check:api": "node scripts/build-api.mjs --check",
    "api:dev": "node scripts/serve-api.mjs",
    "keeper": "node scripts/keeper.mjs",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && node scripts/build-api.mjs --check",
    "sim": "vitest run --config vitest.sim.config.ts sim/balance.sim.ts",
    "sim:audit": "vitest run --config vitest.sim.config.ts sim/audit.sim.ts",
    "sim:daily": "vitest run --config vitest.sim.config.ts sim/daily.sim.ts",
    "sim:hunt": "vitest run --config vitest.sim.config.ts sim/hunt.sim.ts",
    "sim:reel": "vitest run --config vitest.sim.config.ts sim/reel.sim.ts",
    "sim:week": "vitest run --config vitest.sim.config.ts sim/week.sim.ts",
    "live": "vitest run --config vitest.live.config.ts live/cup.live.ts",
    "live:read": "vitest run --config vitest.live.config.ts live/chain.live.ts",
    "live:reel": "vitest run --config vitest.live.config.ts live/reel.live.ts"
  },
  "dependencies": {
    "@fluent.xyz/connect": "0.8.5",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/silkscreen": "5.3.0",
    "@tanstack/react-query": "5.107.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "viem": "2.57.2",
    "wagmi": "2.19.5"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "6.0.3",
    "vite": "8.3.2",
    "vitest": "5.1.0"
  }
}
